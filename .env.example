# =============================================================================
# PUF Website - Environment Variables Template (.env.example)
# Copy this file to .env.local and fill in your actual values.
# DO NOT commit real API keys or secrets to version control.
# =============================================================================

# Notion Integration - Main Contact Form ("Let's Explore Your Vision")
NOTION_API_KEY=your_notion_api_key_here
NOTION_DATABASE_ID=your_notion_contact_database_id_here

# Notion Integration - PUF Building Enquiry Form ("Tell us about your Building")
NOTION_API_KEY_PUF=your_puf_notion_api_key_here
NOTION_DATABASE_ID_PUF=your_puf_notion_database_id_here

# PUF Backend API URL (optional: used for admin panel quotes synchronization)
PUF_BACKEND_URL=http://localhost:4003

# Public Site URL (optional: canonical URL, defaults to https://www.synergypuf.com)
NEXT_PUBLIC_SITE_URL=https://www.synergypuf.com

